[importlinter]
root_packages =
    reactgen
    acquire
include_external_packages = True

[importlinter:contract:analysis-ownership]
name = analysis does not depend on presentation or writes
type = forbidden
source_modules =
    reactgen.pipeline
    reactgen.generate
    reactgen.assessment
forbidden_modules =
    reactgen.cli
    reactgen.adopt
    reactgen.ingest
    reactgen.export
    reactgen.views
    reactgen.needs
    reactgen.presentation

[importlinter:contract:projection-ownership]
name = views do not rerun analysis or access evidence storage
type = forbidden
source_modules =
    reactgen.views
    reactgen.needs
    reactgen.presentation
    reactgen.pathway
forbidden_modules =
    reactgen.pipeline
    reactgen.generate
    reactgen.assessment
    reactgen.screening
    reactgen.numeric
    reactgen.evidence
    reactgen.registry

[importlinter:contract:reactgen-offline]
name = reactgen never reaches the network or the acquisition tools
type = forbidden
source_modules =
    reactgen
forbidden_modules =
    acquire
    http
    urllib
    socket
ignore_imports =
    # urllib.parse is used only for local canonical-ID text encoding.
    reactgen.chemistry -> urllib
