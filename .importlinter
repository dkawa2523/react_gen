[importlinter]
root_packages =
    reactgen
    acquire
include_external_packages = True

[importlinter:contract:reactgen-layers]
name = generation and assessment dependencies point inward
type = layers
layers =
    reactgen.cli
    reactgen.adopt | reactgen.derive | reactgen.export | reactgen.ingest | reactgen.plan
    reactgen.pipeline
    reactgen.assessment
    reactgen.evidence | reactgen.generate
    reactgen.balance | reactgen.case | reactgen.chemistry | reactgen.registry | reactgen.thermo
    reactgen.records
    reactgen.naming | reactgen.model

[importlinter:contract:reactgen-offline]
name = reactgen never reaches the network or the acquisition tools
type = forbidden
source_modules =
    reactgen
forbidden_modules =
    acquire
    http
    urllib
    socket
