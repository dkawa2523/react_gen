digraph reactions {
  graph [rankdir=LR, splines=true, overlap=false, label="reaction network", labelloc=t, fontsize=18, fontname="Helvetica", bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin=0.08];
  edge [fontname="Helvetica", fontsize=8, arrowsize=0.7];
  subgraph cluster_legend {
    label="legend"; fontsize=11; color="#DDDDDD";
    l_n [label="neutral", fillcolor="#E8F5E9"];
    l_p [label="positive ion", fillcolor="#E3F2FD"];
    l_m [label="negative ion", fillcolor="#FFF8E1"];
    l_c [label="proposed", fillcolor="#F7F7F7", style="rounded,filled,dashed"];
    l_x [label="missing property", fillcolor="#F7F7F7", color="#D62728", penwidth=2.0];
  }
  "Ar" [label="Ar\nq=+0 | depth=0\natom,neutral", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="Ar"];
  "Ar+" [label="Ar+\nq=+1 | depth=1\natom,positive_ion\nmissing=2", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="Ar+ | missing=electron_affinity_eV,polarizability_A3"];
  "Ar_4s" [label="Ar_4s\nq=+0 | depth=1\natom,excited,metastable\nmissing=2", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="Ar_4s | missing=collision_radius_A,polarizability_A3"];
  "O" [label="O\nq=+0 | depth=1\natom,neutral,radical\nmissing=2", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="O | missing=collision_radius_A,polarizability_A3"];
  "O+" [label="O+\nq=+1 | depth=1\natomic_ion,positive_ion\nmissing=3", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="O+ | missing=collision_radius_A,electron_affinity_eV,polarizability_A3"];
  "O2" [label="O2\nq=+0 | depth=0\nmolecule,neutral", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="O2"];
  "O2+" [label="O2+\nq=+1 | depth=1\nmolecular_ion,positive_ion\nmissing=4", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="O2+ | missing=collision_radius_A,electron_affinity_eV,ionization_energy_eV,polarizability_A3"];
  "O2_a1Delta" [label="O2_a1Delta\nq=+0 | depth=1\nmetastable,molecule,neutral\nmissing=4", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="O2_a1Delta | missing=collision_radius_A,electron_affinity_eV,ionization_energy_eV,polarizability_A3"];
  "O2_b1Sigma" [label="O2_b1Sigma\nq=+0 | depth=1\nmetastable,molecule,neutral\nmissing=4", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="O2_b1Sigma | missing=collision_radius_A,electron_affinity_eV,ionization_energy_eV,polarizability_A3"];
  "O2_v" [label="O2_v\nq=+0 | depth=1\ncandidate,excited,vibrational", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="O2_v"];
  "O_1D" [label="O_1D\nq=+0 | depth=1\natom,metastable,neutral\nmissing=4", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="O_1D | missing=collision_radius_A,electron_affinity_eV,ionization_energy_eV,polarizability_A3"];
  "O_1S" [label="O_1S\nq=+0 | depth=1\natom,metastable,neutral\nmissing=4", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="O_1S | missing=collision_radius_A,electron_affinity_eV,ionization_energy_eV,polarizability_A3"];
  "Ar" -> "Ar_4s" [label="excitation\nd0 | e_Ar_excitation_4s_lumped", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + Ar -> e + Ar_4s"];
  "Ar" -> "Ar+" [label="ionization\nd0 | e_Ar_ionization", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + Ar -> 2 e + Ar+"];
  "O2" -> "O2_a1Delta" [label="excitation\nd0 | e_O2_excitation_O2_a1Delta", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O2 -> e + O2_a1Delta"];
  "O2" -> "O2_b1Sigma" [label="excitation\nd0 | e_O2_excitation_O2_b1Sigma", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O2 -> e + O2_b1Sigma"];
  "O2" -> "O2+" [label="ionization\nd0 | e_O2_ionization", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O2 -> 2 e + O2+"];
  "O2" -> "O" [label="dissociation\nd0 | e_O2_dissociation_O_O", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O2 -> e + 2 O"];
  "O2" -> "O_1D" [label="dissociation\nd0 | e_O2_dissociation_O_O1D", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O2 -> e + O + O_1D"];
  "O2" -> "O2_v" [label="excitation\nd0 | cand_e_O2_to_e_O2_v", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O2 -> e + O2_v"];
  "O2_v" -> "O2" [label="deexcitation\nd0 | cand_e_O2_v_to_e_O2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O2_v -> e + O2"];
  "O2" -> "O+" [label="dissociative_ionization\nd0 | cand_e_O2_to_e_e_Op_O", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O2 -> e + e + O+ + O"];
  "O2" -> "O_1S" [label="dissociation\nd0 | cand_O2_diss_O_1S", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O2 -> e + O + O_1S"];
  "Ar_4s" -> "Ar+" [label="ionization\nd1 | e_Ar4s_stepwise_ionization", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + Ar_4s -> 2 e + Ar+"];
  "Ar_4s" -> "Ar" [label="deexcitation\nd1 | e_Ar4s_superelastic", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + Ar_4s -> e + Ar"];
  "O" -> "O_1D" [label="excitation\nd1 | e_O_excitation_O_1D", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O -> e + O_1D"];
  "O" -> "O+" [label="ionization\nd1 | e_O_ionization", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O -> 2 e + O+"];
  "O" -> "O_1S" [label="excitation\nd1 | e_O_excitation_O_1S", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O -> e + O_1S"];
  "O2_a1Delta" -> "O2+" [label="ionization\nd1 | e_O2_a1Delta_ionization", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O2_a1Delta -> 2 e + O2+"];
  "O2_a1Delta" -> "O2" [label="deexcitation\nd1 | e_O2_a1Delta_superelastic", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O2_a1Delta -> e + O2"];
  "O2_b1Sigma" -> "O2+" [label="ionization\nd1 | e_O2_b1Sigma_ionization", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O2_b1Sigma -> 2 e + O2+"];
  "O2_b1Sigma" -> "O2" [label="deexcitation\nd1 | e_O2_b1Sigma_superelastic", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O2_b1Sigma -> e + O2"];
  "O_1D" -> "O+" [label="ionization\nd1 | e_O_1D_ionization", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O_1D -> 2 e + O+"];
  "O_1D" -> "O" [label="deexcitation\nd1 | e_O_1D_superelastic", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O_1D -> e + O"];
  "O_1S" -> "O" [label="deexcitation\nd1 | e_O_1S_superelastic", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + O_1S -> e + O"];
  "Ar+" -> "Ar" [label="charge_transfer\nd1 | Arp_O2_charge_transfer", color="#B23B3B", fontcolor="#B23B3B", style="solid", tooltip="Ar+ + O2 -> Ar + O2+"];
  "Ar+" -> "O2+" [label="charge_transfer\nd1 | Arp_O2_charge_transfer", color="#B23B3B", fontcolor="#B23B3B", style="solid", tooltip="Ar+ + O2 -> Ar + O2+"];
  "O2" -> "Ar" [label="charge_transfer\nd1 | Arp_O2_charge_transfer", color="#B23B3B", fontcolor="#B23B3B", style="solid", tooltip="Ar+ + O2 -> Ar + O2+"];
  "O2" -> "O2+" [label="charge_transfer\nd1 | Arp_O2_charge_transfer", color="#B23B3B", fontcolor="#B23B3B", style="solid", tooltip="Ar+ + O2 -> Ar + O2+"];
  "O+" -> "O" [label="charge_transfer\nd1 | Op_O2_charge_transfer", color="#B23B3B", fontcolor="#B23B3B", style="solid", tooltip="O+ + O2 -> O + O2+"];
  "O+" -> "O2+" [label="charge_transfer\nd1 | Op_O2_charge_transfer", color="#B23B3B", fontcolor="#B23B3B", style="solid", tooltip="O+ + O2 -> O + O2+"];
  "O2" -> "O" [label="charge_transfer\nd1 | Op_O2_charge_transfer", color="#B23B3B", fontcolor="#B23B3B", style="solid", tooltip="O+ + O2 -> O + O2+"];
  "O2_a1Delta" -> "O2" [label="reactive_scattering\nd1 | O2a_O2_self_quenching", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="O2 + O2_a1Delta -> 2 O2"];
  "O_1D" -> "O" [label="reactive_scattering\nd1 | O1D_O2_quenching_O2_b1Sigma", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="O_1D + O2 -> O + O2_b1Sigma"];
  "O_1D" -> "O2_b1Sigma" [label="reactive_scattering\nd1 | O1D_O2_quenching_O2_b1Sigma", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="O_1D + O2 -> O + O2_b1Sigma"];
  "O2" -> "O" [label="reactive_scattering\nd1 | O1D_O2_quenching_O2_b1Sigma", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="O_1D + O2 -> O + O2_b1Sigma"];
  "O2" -> "O2_b1Sigma" [label="reactive_scattering\nd1 | O1D_O2_quenching_O2_b1Sigma", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="O_1D + O2 -> O + O2_b1Sigma"];
  "O_1D" -> "O2_a1Delta" [label="reactive_scattering\nd1 | O1D_O2_quenching_O2_a1Delta", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="O_1D + O2 -> O + O2_a1Delta"];
  "O2" -> "O2_a1Delta" [label="reactive_scattering\nd1 | O1D_O2_quenching_O2_a1Delta", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="O_1D + O2 -> O + O2_a1Delta"];
  "O2_a1Delta" -> "O" [label="dissociation\nd1 | cand_e_O2_a1Delta_to_e_O_O", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O2_a1Delta -> e + O + O"];
  "O2_a1Delta" -> "O+" [label="dissociative_ionization\nd1 | cand_e_O2_a1Delta_to_e_e_Op_O", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O2_a1Delta -> e + e + O+ + O"];
  "O2_b1Sigma" -> "O" [label="dissociation\nd1 | cand_e_O2_b1Sigma_to_e_O_O", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O2_b1Sigma -> e + O + O"];
  "O2_b1Sigma" -> "O+" [label="dissociative_ionization\nd1 | cand_e_O2_b1Sigma_to_e_e_Op_O", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O2_b1Sigma -> e + e + O+ + O"];
  "O2_v" -> "O2+" [label="ionization\nd1 | cand_e_O2_v_to_e_e_O2p", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O2_v -> e + e + O2+"];
  "O2_v" -> "O" [label="dissociation\nd1 | cand_e_O2_v_to_e_O_O", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O2_v -> e + O + O"];
  "O2_v" -> "O+" [label="dissociative_ionization\nd1 | cand_e_O2_v_to_e_e_Op_O", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O2_v -> e + e + O+ + O"];
  "O_1S" -> "O+" [label="ionization\nd1 | cand_e_O_1S_to_e_e_Op", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + O_1S -> e + e + O+"];
  "O2_v" -> "O2" [label="vibrational_relaxation\nd1 | cand_O2_v_Ar_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + Ar -> O2 + Ar"];
  "O2_v" -> "Ar" [label="vibrational_relaxation\nd1 | cand_O2_v_Ar_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + Ar -> O2 + Ar"];
  "Ar" -> "O2" [label="vibrational_relaxation\nd1 | cand_O2_v_Ar_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + Ar -> O2 + Ar"];
  "O2_v" -> "Ar_4s" [label="vibrational_relaxation\nd1 | cand_O2_v_Ar_4s_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + Ar_4s -> O2 + Ar_4s"];
  "Ar_4s" -> "O2" [label="vibrational_relaxation\nd1 | cand_O2_v_Ar_4s_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + Ar_4s -> O2 + Ar_4s"];
  "O2_v" -> "O" [label="vibrational_relaxation\nd1 | cand_O2_v_O_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + O -> O2 + O"];
  "O" -> "O2" [label="vibrational_relaxation\nd1 | cand_O2_v_O_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + O -> O2 + O"];
  "O2_v" -> "O2_a1Delta" [label="vibrational_relaxation\nd1 | cand_O2_v_O2_a1Delta_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + O2_a1Delta -> O2 + O2_a1Delta"];
  "O2_v" -> "O2_b1Sigma" [label="vibrational_relaxation\nd1 | cand_O2_v_O2_b1Sigma_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + O2_b1Sigma -> O2 + O2_b1Sigma"];
  "O2_b1Sigma" -> "O2" [label="vibrational_relaxation\nd1 | cand_O2_v_O2_b1Sigma_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + O2_b1Sigma -> O2 + O2_b1Sigma"];
  "O2_v" -> "O_1D" [label="vibrational_relaxation\nd1 | cand_O2_v_O_1D_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + O_1D -> O2 + O_1D"];
  "O_1D" -> "O2" [label="vibrational_relaxation\nd1 | cand_O2_v_O_1D_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + O_1D -> O2 + O_1D"];
  "O2_v" -> "O_1S" [label="vibrational_relaxation\nd1 | cand_O2_v_O_1S_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + O_1S -> O2 + O_1S"];
  "O_1S" -> "O2" [label="vibrational_relaxation\nd1 | cand_O2_v_O_1S_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="O2_v + O_1S -> O2 + O_1S"];
  "Ar+" -> "O+" [label="charge_transfer\nd1 | cand_Arp_O_char_Ar_Op", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O -> Ar + O+"];
  "O" -> "Ar" [label="charge_transfer\nd1 | cand_Arp_O_char_Ar_Op", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O -> Ar + O+"];
  "O" -> "O+" [label="charge_transfer\nd1 | cand_Arp_O_char_Ar_Op", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O -> Ar + O+"];
  "O2_a1Delta" -> "Ar" [label="charge_transfer\nd1 | cand_Arp_O2_a1Delta_char_Ar_O2p", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O2_a1Delta -> Ar + O2+"];
  "O2_a1Delta" -> "O2+" [label="charge_transfer\nd1 | cand_Arp_O2_a1Delta_char_Ar_O2p", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O2_a1Delta -> Ar + O2+"];
  "O2_b1Sigma" -> "Ar" [label="charge_transfer\nd1 | cand_Arp_O2_b1Sigma_char_Ar_O2p", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O2_b1Sigma -> Ar + O2+"];
  "O2_b1Sigma" -> "O2+" [label="charge_transfer\nd1 | cand_Arp_O2_b1Sigma_char_Ar_O2p", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O2_b1Sigma -> Ar + O2+"];
  "Ar+" -> "O" [label="dissociative_charge_transfer\nd1 | cand_Arp_O2_b1Sigma_diss_Ar_Op_O", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O2_b1Sigma -> Ar + O+ + O"];
  "O2_b1Sigma" -> "O+" [label="dissociative_charge_transfer\nd1 | cand_Arp_O2_b1Sigma_diss_Ar_Op_O", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O2_b1Sigma -> Ar + O+ + O"];
  "O2_b1Sigma" -> "O" [label="dissociative_charge_transfer\nd1 | cand_Arp_O2_b1Sigma_diss_Ar_Op_O", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O2_b1Sigma -> Ar + O+ + O"];
  "O2_v" -> "Ar" [label="charge_transfer\nd1 | cand_Arp_O2_v_char_Ar_O2p", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O2_v -> Ar + O2+"];
  "O2_v" -> "O2+" [label="charge_transfer\nd1 | cand_Arp_O2_v_char_Ar_O2p", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O2_v -> Ar + O2+"];
  "O_1D" -> "Ar" [label="charge_transfer\nd1 | cand_Arp_O_1D_char_Ar_Op", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O_1D -> Ar + O+"];
  "O_1D" -> "O+" [label="charge_transfer\nd1 | cand_Arp_O_1D_char_Ar_Op", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O_1D -> Ar + O+"];
  "O_1S" -> "Ar" [label="charge_transfer\nd1 | cand_Arp_O_1S_char_Ar_Op", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O_1S -> Ar + O+"];
  "O_1S" -> "O+" [label="charge_transfer\nd1 | cand_Arp_O_1S_char_Ar_Op", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="Ar+ + O_1S -> Ar + O+"];
  "O+" -> "Ar+" [label="charge_transfer\nd1 | cand_Op_Ar_4s_char_O_Arp", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="O+ + Ar_4s -> O + Ar+"];
  "Ar_4s" -> "O" [label="charge_transfer\nd1 | cand_Op_Ar_4s_char_O_Arp", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="O+ + Ar_4s -> O + Ar+"];
  "Ar_4s" -> "Ar+" [label="charge_transfer\nd1 | cand_Op_Ar_4s_char_O_Arp", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="O+ + Ar_4s -> O + Ar+"];
  "O2_a1Delta" -> "O" [label="charge_transfer\nd1 | cand_Op_O2_a1Delta_char_O_O2p", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="O+ + O2_a1Delta -> O + O2+"];
  "O2_v" -> "O" [label="charge_transfer\nd1 | cand_Op_O2_v_char_O_O2p", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="O+ + O2_v -> O + O2+"];
  "O2+" -> "O2" [label="charge_transfer\nd1 | cand_O2p_Ar_4s_char_O2_Arp", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="O2+ + Ar_4s -> O2 + Ar+"];
  "O2+" -> "Ar+" [label="charge_transfer\nd1 | cand_O2p_Ar_4s_char_O2_Arp", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="O2+ + Ar_4s -> O2 + Ar+"];
  "Ar_4s" -> "O2" [label="charge_transfer\nd1 | cand_O2p_Ar_4s_char_O2_Arp", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="O2+ + Ar_4s -> O2 + Ar+"];
  "O2+" -> "O+" [label="dissociative_charge_transfer\nd1 | cand_O2p_Ar_4s_diss_Op_O_Ar", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="O2+ + Ar_4s -> O+ + O + Ar"];
  "O2+" -> "O" [label="dissociative_charge_transfer\nd1 | cand_O2p_Ar_4s_diss_Op_O_Ar", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="O2+ + Ar_4s -> O+ + O + Ar"];
  "O2+" -> "Ar" [label="dissociative_charge_transfer\nd1 | cand_O2p_Ar_4s_diss_Op_O_Ar", color="#B23B3B", fontcolor="#B23B3B", style="dotted", tooltip="O2+ + Ar_4s -> O+ + O + Ar"];
