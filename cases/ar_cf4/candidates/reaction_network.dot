digraph reactions {
  graph [rankdir=LR, splines=true, overlap=false, label="reaction network", labelloc=t, fontsize=18, fontname="Helvetica", bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin=0.08];
  edge [fontname="Helvetica", fontsize=8, arrowsize=0.7];
  subgraph cluster_legend {
    label="legend"; fontsize=11; color="#DDDDDD";
    l_n [label="neutral", fillcolor="#E8F5E9"];
    l_p [label="positive ion", fillcolor="#E3F2FD"];
    l_m [label="negative ion", fillcolor="#FFF8E1"];
    l_c [label="proposed", fillcolor="#F7F7F7", style="rounded,filled,dashed"];
    l_x [label="missing property", fillcolor="#F7F7F7", color="#D62728", penwidth=2.0];
  }
  "Ar" [label="Ar\nq=+0 | depth=0\natom,neutral", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="Ar"];
  "Ar+" [label="Ar+\nq=+1 | depth=1\natom,positive_ion\nmissing=2", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="Ar+ | missing=electron_affinity_eV,polarizability_A3"];
  "Ar_4s" [label="Ar_4s\nq=+0 | depth=1\natom,excited,metastable", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="Ar_4s"];
  "C" [label="C\nq=+0 | depth=2\natom,neutral,radical", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="C"];
  "C+" [label="C+\nq=+1 | depth=2\ncandidate", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="C+"];
  "CF" [label="CF\nq=+0 | depth=2\nmolecule,neutral,radical", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="CF"];
  "CF*" [label="CF*\nq=+0 | depth=3\ncandidate,excited,lumped", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="CF*"];
  "CF+" [label="CF+\nq=+1 | depth=2\ncandidate", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="CF+"];
  "CF2" [label="CF2\nq=+0 | depth=1\nmolecule,neutral,radical", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="CF2"];
  "CF2*" [label="CF2*\nq=+0 | depth=2\ncandidate,excited,lumped", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="CF2*"];
  "CF2+" [label="CF2+\nq=+1 | depth=1\nmolecular_ion,positive_ion\nmissing=4", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="CF2+ | missing=dipole_moment_D,electron_affinity_eV,ionization_energy_eV,polarizability_A3"];
  "CF2_v" [label="CF2_v\nq=+0 | depth=2\ncandidate,excited,vibrational", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="CF2_v"];
  "CF3" [label="CF3\nq=+0 | depth=1\nmolecule,neutral,radical", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="CF3"];
  "CF3*" [label="CF3*\nq=+0 | depth=2\ncandidate,excited,lumped", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="CF3*"];
  "CF3+" [label="CF3+\nq=+1 | depth=1\nmolecular_ion,positive_ion\nmissing=4", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="CF3+ | missing=dipole_moment_D,electron_affinity_eV,ionization_energy_eV,polarizability_A3"];
  "CF3_v" [label="CF3_v\nq=+0 | depth=2\ncandidate,excited,vibrational", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="CF3_v"];
  "CF4" [label="CF4\nq=+0 | depth=0\nmolecule,neutral\nmissing=1", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="CF4 | missing=electron_affinity_eV"];
  "CF4*" [label="CF4*\nq=+0 | depth=1\ncandidate,excited,lumped", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="CF4*"];
  "CF4+" [label="CF4+\nq=+1 | depth=2\nmolecular_ion,positive_ion\nmissing=4", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="CF4+ | missing=dipole_moment_D,electron_affinity_eV,ionization_energy_eV,polarizability_A3"];
  "CF4_v" [label="CF4_v\nq=+0 | depth=1\ncandidate,excited,vibrational", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="CF4_v"];
  "CF_v" [label="CF_v\nq=+0 | depth=3\ncandidate,excited,vibrational", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="CF_v"];
  "C_1D" [label="C_1D\nq=+0 | depth=2\natom,metastable,neutral\nmissing=3", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="C_1D | missing=collision_radius_A,electron_affinity_eV,ionization_energy_eV"];
  "C_1S" [label="C_1S\nq=+0 | depth=2\natom,metastable,neutral\nmissing=3", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="C_1S | missing=collision_radius_A,electron_affinity_eV,ionization_energy_eV"];
  "F" [label="F\nq=+0 | depth=1\natom,neutral,radical", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="F"];
  "F*" [label="F*\nq=+0 | depth=2\ncandidate,excited,lumped", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="F*"];
  "F+" [label="F+\nq=+1 | depth=1\natom,positive_ion\nmissing=3", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="F+ | missing=electron_affinity_eV,ionization_energy_eV,polarizability_A3"];
  "F2" [label="F2\nq=+0 | depth=1\nmolecule,neutral", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="F2"];
  "F2*" [label="F2*\nq=+0 | depth=2\ncandidate,excited,lumped", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="F2*"];
  "F2+" [label="F2+\nq=+1 | depth=2\nmolecular_ion,positive_ion", fillcolor="#E3F2FD", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="F2+"];
  "F2_v" [label="F2_v\nq=+0 | depth=2\ncandidate,excited,vibrational", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="F2_v"];
  "Ar" -> "Ar_4s" [label="excitation\nd0 | e_Ar_excitation_4s_lumped", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + Ar -> e + Ar_4s"];
  "Ar" -> "Ar+" [label="ionization\nd0 | e_Ar_ionization", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + Ar -> 2 e + Ar+"];
  "CF4" -> "CF3" [label="dissociation\nd0 | e_CF4_dissociation_CF3_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF4 -> e + CF3 + F"];
  "CF4" -> "F" [label="dissociation\nd0 | e_CF4_dissociation_CF3_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF4 -> e + CF3 + F"];
  "CF4" -> "CF2" [label="dissociation\nd0 | e_CF4_dissociation_CF2_2F", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF4 -> e + CF2 + 2 F"];
  "CF4" -> "CF3+" [label="dissociative_ionization\nd0 | e_CF4_dissociative_ionization_CF3p", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF4 -> 2 e + CF3+ + F"];
  "CF4" -> "F+" [label="dissociative_ionization\nd0 | e_CF4_dissociative_ionization_Fp_CF3", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF4 -> 2 e + CF3 + F+"];
  "CF4" -> "CF2+" [label="dissociative_ionization\nd0 | e_CF4_dissociative_ionization_CF2p", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF4 -> 2 e + CF2+ + 2 F"];
  "CF4" -> "CF4_v" [label="excitation\nd0 | cand_e_CF4_to_e_CF4_v", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4 -> e + CF4_v"];
  "CF4_v" -> "CF4" [label="deexcitation\nd0 | cand_e_CF4_v_to_e_CF4", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4_v -> e + CF4"];
  "CF4" -> "CF4*" [label="excitation\nd0 | cand_e_CF4_to_e_CF4*", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4 -> e + CF4*"];
  "CF4*" -> "CF4" [label="deexcitation\nd0 | cand_e_CF4*_to_e_CF4", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4* -> e + CF4"];
  "CF4" -> "F2" [label="dissociation\nd0 | cand_e_CF4_to_e_CF2_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4 -> e + CF2 + F2"];
  "Ar_4s" -> "Ar+" [label="ionization\nd1 | e_Ar4s_stepwise_ionization", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + Ar_4s -> 2 e + Ar+"];
  "Ar_4s" -> "Ar" [label="deexcitation\nd1 | e_Ar4s_superelastic", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + Ar_4s -> e + Ar"];
  "CF2" -> "CF2+" [label="ionization\nd1 | e_CF2_ionization_CF2p", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF2 -> 2 e + CF2+"];
  "CF2" -> "CF" [label="dissociation\nd1 | e_CF2_dissociation_CF_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF2 -> e + CF + F"];
  "CF2" -> "F" [label="dissociation\nd1 | e_CF2_dissociation_CF_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF2 -> e + CF + F"];
  "CF2" -> "C" [label="dissociation\nd1 | e_CF2_dissociation_C_2F", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF2 -> e + C + 2 F"];
  "CF3" -> "CF3+" [label="ionization\nd1 | e_CF3_ionization_CF3p", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF3 -> 2 e + CF3+"];
  "CF3" -> "CF2" [label="dissociation\nd1 | e_CF3_dissociation_CF2_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF3 -> e + CF2 + F"];
  "CF3" -> "F" [label="dissociation\nd1 | e_CF3_dissociation_CF2_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + CF3 -> e + CF2 + F"];
  "F" -> "F+" [label="ionization\nd1 | e_F_ionization", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + F -> 2 e + F+"];
  "F2" -> "F" [label="dissociation\nd1 | e_F2_dissociation_2F", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + F2 -> e + 2 F"];
  "F2" -> "F2+" [label="ionization\nd1 | e_F2_ionization_F2p", color="#2F6DB3", fontcolor="#2F6DB3", style="dashed", tooltip="e + F2 -> 2 e + F2+"];
  "F2" -> "CF3" [label="reactive_scattering\nd1 | F2_CF2_to_CF3_F", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="F2 + CF2 -> CF3 + F"];
  "F2" -> "F" [label="reactive_scattering\nd1 | F2_CF2_to_CF3_F", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="F2 + CF2 -> CF3 + F"];
  "CF2" -> "CF3" [label="reactive_scattering\nd1 | F2_CF2_to_CF3_F", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="F2 + CF2 -> CF3 + F"];
  "CF2" -> "F" [label="reactive_scattering\nd1 | F2_CF2_to_CF3_F", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="F2 + CF2 -> CF3 + F"];
  "F2" -> "CF4" [label="reactive_scattering\nd1 | F2_CF3_to_CF4_F", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="F2 + CF3 -> CF4 + F"];
  "CF3" -> "CF4" [label="reactive_scattering\nd1 | F2_CF3_to_CF4_F", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="F2 + CF3 -> CF4 + F"];
  "CF3" -> "F" [label="reactive_scattering\nd1 | F2_CF3_to_CF4_F", color="#3F7A4B", fontcolor="#3F7A4B", style="solid", tooltip="F2 + CF3 -> CF4 + F"];
  "CF2" -> "CF2_v" [label="excitation\nd1 | cand_e_CF2_to_e_CF2_v", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF2 -> e + CF2_v"];
  "CF2_v" -> "CF2" [label="deexcitation\nd1 | cand_e_CF2_v_to_e_CF2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF2_v -> e + CF2"];
  "CF2" -> "CF2*" [label="excitation\nd1 | cand_e_CF2_to_e_CF2*", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF2 -> e + CF2*"];
  "CF2*" -> "CF2" [label="deexcitation\nd1 | cand_e_CF2*_to_e_CF2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF2* -> e + CF2"];
  "CF2" -> "CF+" [label="dissociative_ionization\nd1 | cand_e_CF2_to_e_e_CFp_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF2 -> e + e + CF+ + F"];
  "CF2" -> "F2" [label="dissociation\nd1 | cand_e_CF2_to_e_C_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF2 -> e + C + F2"];
  "CF2" -> "C+" [label="dissociative_ionization\nd1 | cand_e_CF2_to_e_e_Cp_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF2 -> e + e + C+ + F2"];
  "CF3" -> "CF3_v" [label="excitation\nd1 | cand_e_CF3_to_e_CF3_v", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF3 -> e + CF3_v"];
  "CF3_v" -> "CF3" [label="deexcitation\nd1 | cand_e_CF3_v_to_e_CF3", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF3_v -> e + CF3"];
  "CF3" -> "CF3*" [label="excitation\nd1 | cand_e_CF3_to_e_CF3*", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF3 -> e + CF3*"];
  "CF3*" -> "CF3" [label="deexcitation\nd1 | cand_e_CF3*_to_e_CF3", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF3* -> e + CF3"];
  "CF3" -> "CF2+" [label="dissociative_ionization\nd1 | cand_e_CF3_to_e_e_CF2p_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF3 -> e + e + CF2+ + F"];
  "CF3" -> "CF" [label="dissociation\nd1 | cand_e_CF3_to_e_CF_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF3 -> e + CF + F2"];
  "CF3" -> "F2" [label="dissociation\nd1 | cand_e_CF3_to_e_CF_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF3 -> e + CF + F2"];
  "CF3" -> "CF+" [label="dissociative_ionization\nd1 | cand_e_CF3_to_e_e_CFp_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF3 -> e + e + CF+ + F2"];
  "CF4*" -> "CF4+" [label="ionization\nd1 | cand_e_CF4*_to_e_e_CF4p", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4* -> e + e + CF4+"];
  "CF4*" -> "CF3" [label="dissociation\nd1 | cand_e_CF4*_to_e_CF3_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4* -> e + CF3 + F"];
  "CF4*" -> "F" [label="dissociation\nd1 | cand_e_CF4*_to_e_CF3_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4* -> e + CF3 + F"];
  "CF4*" -> "CF3+" [label="dissociative_ionization\nd1 | cand_e_CF4*_to_e_e_CF3p_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4* -> e + e + CF3+ + F"];
  "CF4*" -> "CF2" [label="dissociation\nd1 | cand_e_CF4*_to_e_CF2_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4* -> e + CF2 + F2"];
  "CF4*" -> "F2" [label="dissociation\nd1 | cand_e_CF4*_to_e_CF2_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4* -> e + CF2 + F2"];
  "CF4*" -> "CF2+" [label="dissociative_ionization\nd1 | cand_e_CF4*_to_e_e_CF2p_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4* -> e + e + CF2+ + F2"];
  "CF4_v" -> "CF4+" [label="ionization\nd1 | cand_e_CF4_v_to_e_e_CF4p", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4_v -> e + e + CF4+"];
  "CF4_v" -> "CF3" [label="dissociation\nd1 | cand_e_CF4_v_to_e_CF3_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4_v -> e + CF3 + F"];
  "CF4_v" -> "F" [label="dissociation\nd1 | cand_e_CF4_v_to_e_CF3_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4_v -> e + CF3 + F"];
  "CF4_v" -> "CF3+" [label="dissociative_ionization\nd1 | cand_e_CF4_v_to_e_e_CF3p_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4_v -> e + e + CF3+ + F"];
  "CF4_v" -> "CF2" [label="dissociation\nd1 | cand_e_CF4_v_to_e_CF2_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4_v -> e + CF2 + F2"];
  "CF4_v" -> "F2" [label="dissociation\nd1 | cand_e_CF4_v_to_e_CF2_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4_v -> e + CF2 + F2"];
  "CF4_v" -> "CF2+" [label="dissociative_ionization\nd1 | cand_e_CF4_v_to_e_e_CF2p_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF4_v -> e + e + CF2+ + F2"];
  "F" -> "F*" [label="excitation\nd1 | cand_e_F_to_e_F*", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + F -> e + F*"];
  "F*" -> "F" [label="deexcitation\nd1 | cand_e_F*_to_e_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + F* -> e + F"];
  "F2" -> "F2_v" [label="excitation\nd1 | cand_e_F2_to_e_F2_v", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + F2 -> e + F2_v"];
  "F2_v" -> "F2" [label="deexcitation\nd1 | cand_e_F2_v_to_e_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + F2_v -> e + F2"];
  "F2" -> "F2*" [label="excitation\nd1 | cand_e_F2_to_e_F2*", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + F2 -> e + F2*"];
  "F2*" -> "F2" [label="deexcitation\nd1 | cand_e_F2*_to_e_F2", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + F2* -> e + F2"];
  "F2" -> "F+" [label="dissociative_ionization\nd1 | cand_e_F2_to_e_e_Fp_F", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + F2 -> e + e + F+ + F"];
  "CF2" -> "C_1D" [label="dissociation\nd1 | cand_CF2_diss_C_1D", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF2 -> e + F2 + C_1D"];
  "CF2" -> "C_1S" [label="dissociation\nd1 | cand_CF2_diss_C_1S", color="#2F6DB3", fontcolor="#2F6DB3", style="dotted", tooltip="e + CF2 -> e + F2 + C_1S"];
  "CF4_v" -> "CF4" [label="vibrational_relaxation\nd1 | cand_CF4_v_Ar_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="CF4_v + Ar -> CF4 + Ar"];
  "CF4_v" -> "Ar" [label="vibrational_relaxation\nd1 | cand_CF4_v_Ar_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="CF4_v + Ar -> CF4 + Ar"];
  "Ar" -> "CF4" [label="vibrational_relaxation\nd1 | cand_CF4_v_Ar_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="CF4_v + Ar -> CF4 + Ar"];
  "CF4_v" -> "Ar_4s" [label="vibrational_relaxation\nd1 | cand_CF4_v_Ar_4s_vt", color="#3F7A4B", fontcolor="#3F7A4B", style="dotted", tooltip="CF4_v + Ar_4s -> CF4 + Ar_4s"];
