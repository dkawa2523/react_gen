  "SF2+" [label="SF2+\nq=+1 | depth=1\nmolecular_ion,positive_ion", fillcolor="#E3F2FD", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="SF2+"];
  "SF2_v" [label="SF2_v\nq=+0 | depth=2\ncandidate,excited,vibrational", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="SF2_v"];
  "SF3" [label="SF3\nq=+0 | depth=1\nmolecule,neutral,radical\nmissing=4", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="SF3 | missing=collision_radius_A,dipole_moment_D,enthalpy_formation_eV,polarizability_A3"];
  "SF3*" [label="SF3*\nq=+0 | depth=2\ncandidate,excited,lumped", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="SF3*"];
  "SF3+" [label="SF3+\nq=+1 | depth=1\nmolecular_ion,positive_ion\nmissing=6", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="SF3+ | missing=collision_radius_A,dipole_moment_D,electron_affinity_eV,enthalpy_formation_eV,ionization_energy_eV,polarizability_A3"];
  "SF3_v" [label="SF3_v\nq=+0 | depth=2\ncandidate,excited,vibrational", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="SF3_v"];
  "SF4" [label="SF4\nq=+0 | depth=1\nmolecule,neutral\nmissing=3", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="SF4 | missing=collision_radius_A,dipole_moment_D,polarizability_A3"];
  "SF4*" [label="SF4*\nq=+0 | depth=2\ncandidate,excited,lumped", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="SF4*"];
  "SF4+" [label="SF4+\nq=+1 | depth=1\nmolecular_ion,positive_ion\nmissing=6", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="SF4+ | missing=collision_radius_A,dipole_moment_D,electron_affinity_eV,enthalpy_formation_eV,ionization_energy_eV,polarizability_A3"];
