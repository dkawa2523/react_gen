digraph reactions {
  graph [rankdir=LR, splines=true, overlap=false, label="species lineage", labelloc=t, fontsize=18, fontname="Helvetica", bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin=0.08];
  edge [fontname="Helvetica", fontsize=8, arrowsize=0.7];
  subgraph cluster_legend {
    label="legend"; fontsize=11; color="#DDDDDD";
    l_n [label="neutral", fillcolor="#E8F5E9"];
    l_p [label="positive ion", fillcolor="#E3F2FD"];
    l_m [label="negative ion", fillcolor="#FFF8E1"];
    l_c [label="proposed", fillcolor="#F7F7F7", style="rounded,filled,dashed"];
    l_x [label="missing property", fillcolor="#F7F7F7", color="#D62728", penwidth=2.0];
  }
  "Ar" [label="Ar\nq=+0 | depth=0\natom,neutral", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="Ar"];
  "Ar+" [label="Ar+\nq=+1 | depth=1\natom,positive_ion\nmissing=2", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="Ar+ | missing=electron_affinity_eV,polarizability_A3"];
  "Ar_4s" [label="Ar_4s\nq=+0 | depth=1\natom,excited,metastable", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="Ar_4s"];
  "F" [label="F\nq=+0 | depth=1\natom,neutral,radical", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="F"];
  "F*" [label="F*\nq=+0 | depth=2\ncandidate,excited,lumped", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="F*"];
  "F+" [label="F+\nq=+1 | depth=1\natom,positive_ion\nmissing=3", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="F+ | missing=electron_affinity_eV,ionization_energy_eV,polarizability_A3"];
  "F2" [label="F2\nq=+0 | depth=1\nmolecule,neutral", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="F2"];
  "F2*" [label="F2*\nq=+0 | depth=2\ncandidate,excited,lumped", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="F2*"];
  "F2+" [label="F2+\nq=+1 | depth=2\nmolecular_ion,positive_ion", fillcolor="#E3F2FD", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="F2+"];
  "F2_v" [label="F2_v\nq=+0 | depth=2\ncandidate,excited,vibrational", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="F2_v"];
  "FO" [label="FO\nq=+0 | depth=2\nmolecule,neutral,radical", fillcolor="#E8F5E9", style="rounded,filled", color="#666666", penwidth=1.0, tooltip="FO"];
  "FO*" [label="FO*\nq=+0 | depth=3\ncandidate,excited,lumped", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="FO*"];
  "FO_v" [label="FO_v\nq=+0 | depth=3\ncandidate,excited,vibrational", fillcolor="#F7F7F7", style="rounded,filled,dashed", color="#666666", penwidth=1.0, tooltip="FO_v"];
  "O" [label="O\nq=+0 | depth=1\natom,neutral,radical\nmissing=1", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="O | missing=collision_radius_A"];
  "O+" [label="O+\nq=+1 | depth=1\natomic_ion,positive_ion\nmissing=3", fillcolor="#E3F2FD", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="O+ | missing=collision_radius_A,electron_affinity_eV,polarizability_A3"];
