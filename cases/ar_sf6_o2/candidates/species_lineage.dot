  "O2_a1Delta" [label="O2_a1Delta\nq=+0 | depth=1\nmetastable,molecule,neutral\nmissing=2", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="O2_a1Delta | missing=electron_affinity_eV,ionization_energy_eV"];
  "O2_b1Sigma" [label="O2_b1Sigma\nq=+0 | depth=1\nmetastable,molecule,neutral\nmissing=2", fillcolor="#E8F5E9", style="rounded,filled", color="#D62728", penwidth=2.0, tooltip="O2_b1Sigma | missing=electron_affinity_eV,ionization_energy_eV"];
